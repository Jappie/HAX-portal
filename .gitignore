# --- Local Dependencies ---
# Never push the symlinks or downloaded packages. 
# This includes the "shared" symlink created by the link:../shared dependency.
node_modules/

# --- Synology & System Files ---
# Ignore Synology metadata folders and OS-specific files
@eaDir/
.DS_Store
Thumbs.db

# --- Environment & Secrets ---
# Keep your local ports and private configs off GitHub
.env
.env.local
.env.*.local

# --- Logs & Debugging ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# --- Build & Temporary Files ---
# If you ever use a build step, ignore the output
dist/
build/
.cache/
*.tsbuildinfo
